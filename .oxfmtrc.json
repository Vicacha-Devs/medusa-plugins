{
  "printWidth": 80,
  "arrowParens": "always",
  "semi": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "coverage",
    "**/coverage/**",
    "dist",
    "**/dist/**",
    ".medusa",
    "**/.medusa/**",
    ".turbo",
    "**/.turbo/**",
    ".qa",
    "**/.qa/**",
    "**/.astro/**",
    "**/public/vendor/**",
    "node_modules",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "**/CHANGELOG.md"
  ]
}
