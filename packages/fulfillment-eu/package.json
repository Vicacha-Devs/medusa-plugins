{
  "name": "@vicacha-devs/medusa-fulfillment-eu",
  "version": "0.1.2",
  "description": "EU & Benelux fulfillment provider plugin for Medusa v2 (PostNL letterbox, Sendcloud EU parcel, and Rotterdam LCL pallet freight).",
  "keywords": [
    "eu",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-fulfillment",
    "medusa-plugin-integration",
    "medusa-v2",
    "plugin",
    "postnl",
    "sendcloud"
  ],
  "license": "MIT",
  "author": "Vicacha Devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/medusa-plugins.git",
    "directory": "packages/fulfillment-eu"
  },
  "files": [
    ".medusa/server",
    "dist",
    "src",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers/*": {
      "import": "./dist/providers/*/index.js",
      "default": "./dist/providers/*/index.js",
      "types": "./dist/providers/*/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --import ../plugin-testing/register-js-extension.mjs --test src/__tests__/*.spec.ts"
  },
  "devDependencies": {
    "@medusajs/framework": "2.23.0",
    "@types/node": "^22.13.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.0.0"
  }
}
