{
  "name": "@vicacha-devs/medusa-plugin-typesense",
  "version": "0.1.0",
  "description": "Full-featured Typesense search, vector/hybrid AI search, merchandising (synonyms, curations, stopwords), custom entity indexing, and InstantSearch plugin for Medusa v2",
  "keywords": [
    "ecommerce",
    "faceted-search",
    "hybrid-search",
    "instantsearch",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-search",
    "medusa-plugin-typesense",
    "medusa-search",
    "medusa-search-provider",
    "medusa-v2",
    "search",
    "semantic-search",
    "typesense",
    "vector-search"
  ],
  "license": "MIT",
  "author": "Vicacha Devs",
  "files": [
    ".medusa/server",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./.medusa/server/src/hooks/index.js"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./src/sdk/index.ts",
      "default": "./.medusa/server/src/sdk/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./.medusa/server/src/types/index.js"
    },
    "./indexes": {
      "types": "./src/indexes/index.ts",
      "import": "./.medusa/server/src/indexes/index.js",
      "default": "./.medusa/server/src/indexes/index.js"
    },
    "./workflows": {
      "types": "./src/workflows/index.ts",
      "import": "./.medusa/server/src/workflows/index.js",
      "default": "./.medusa/server/src/workflows/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./rbac": {
      "import": "./src/rbac.ts",
      "default": "./.medusa/server/src/rbac.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json --resolve-full-paths",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --import ../plugin-testing/register-js-extension.mjs --test src/__tests__/*.spec.ts"
  },
  "dependencies": {
    "typesense": "^3.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/core-flows": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@mikro-orm/migrations": "6.4.3",
    "@swc/core": "1.7.28",
    "@types/node": "20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jiti": "2.0.0",
    "prop-types": "15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "tsc-alias": "^1.9.2",
    "typescript": "5.6.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@medusajs/admin-sdk": "^2.23.0",
    "@medusajs/admin-shared": "^2.23.0",
    "@medusajs/cli": "^2.23.0",
    "@medusajs/core-flows": "^2.23.0",
    "@medusajs/framework": "^2.23.0",
    "@medusajs/icons": "^2.23.0",
    "@medusajs/js-sdk": "^2.23.0",
    "@medusajs/medusa": "^2.23.0",
    "@medusajs/test-utils": "^2.23.0",
    "@medusajs/types": "^2.23.0",
    "@medusajs/ui": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.20.0"
}
