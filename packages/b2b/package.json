{
  "name": "@vicacha-devs/medusa-plugin-b2b",
  "version": "0.0.1",
  "description": "B2B commerce capabilities for Medusa v2: companies, employees, quotes, approvals, spending limits, and B2B cart workflows.",
  "keywords": [
    "b2b",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-b2b",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-v2",
    "plugin"
  ],
  "license": "MIT",
  "author": "Vicacha Devs",
  "files": [
    ".medusa/server",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "default": "./.medusa/server/src/types/index.js"
    },
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./rbac": {
      "import": "./src/rbac.ts",
      "default": "./.medusa/server/src/rbac.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json --resolve-full-paths",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../plugin-testing/register-ts-resolver.mjs --import ../plugin-testing/register-js-extension.mjs --test src/__tests__/*.spec.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "clean": "rm -rf .medusa node_modules"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/core-flows": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@mikro-orm/migrations": "6.4.3",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@swc/core": "1.7.28",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@types/lodash": "4.17.16",
    "@types/node": "20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vicacha-devs/medusa-shared-admin": "workspace:*",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "jiti": "2.0.0",
    "lodash": "4.18.1",
    "prop-types": "15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "5.6.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/core-flows": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "lodash": "4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.20.0"
}
