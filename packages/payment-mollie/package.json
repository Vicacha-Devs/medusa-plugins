{
  "name": "@vicacha-devs/medusa-payment-mollie",
  "version": "0.0.1",
  "description": "Mollie (iDEAL, Bancontact, SEPA, Cards) and B2B Net-14 Invoice payment provider plugin for Medusa v2.",
  "keywords": [
    "bancontact",
    "ideal",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-v2",
    "mollie",
    "plugin",
    "sepa"
  ],
  "license": "MIT",
  "author": "Vicacha Devs",
  "files": [
    ".medusa/server",
    "dist",
    "src",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": {
      "import": "./dist/providers/*/index.js",
      "types": "./dist/providers/*/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --import ../plugin-testing/register-js-extension.mjs --test src/__tests__/*.spec.ts"
  },
  "devDependencies": {
    "@medusajs/framework": "2.23.0",
    "@types/node": "^22.13.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.0.0"
  }
}
