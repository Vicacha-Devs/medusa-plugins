{
  "name": "@vicacha-devs/medusa-payment-bold",
  "version": "0.1.0",
  "description": "Comprehensive Bold Colombia payment integration for Medusa v2 supporting Button, Links, Online API (Cards, PSE, Nequi, QR), and Smart POS Terminals.",
  "keywords": [
    "bold",
    "bre-b",
    "dataphone",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-bold",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-v2",
    "nequi",
    "plugin",
    "pse"
  ],
  "license": "MIT",
  "author": "Vicacha Devs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vicacha-Devs/medusa-plugins.git",
    "directory": "packages/payment-bold"
  },
  "files": [
    ".medusa/server",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./hooks": {
      "import": "./src/hooks/index.ts",
      "default": "./.medusa/server/src/hooks/index.js"
    },
    "./sdk": {
      "import": "./src/sdk/client.ts",
      "default": "./.medusa/server/src/sdk/client.js"
    },
    "./lib": {
      "import": "./src/lib/index.ts",
      "default": "./.medusa/server/src/lib/index.js"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "default": "./.medusa/server/src/types/index.js"
    },
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./rbac": {
      "import": "./src/rbac.ts",
      "default": "./.medusa/server/src/rbac.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json --resolve-full-paths",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --import ../plugin-testing/register-js-extension.mjs --test src/__tests__/*.spec.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "clean": "rm -rf .medusa node_modules",
    "typecheck": "tsc --noEmit",
    "emulator": "node ./scripts/bold-emulator.ts"
  },
  "dependencies": {
    "@medusajs/dashboard": "2.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@swc/core": "^1.7.28",
    "@tanstack/react-query": "5.107.1",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vicacha-devs/medusa-shared-admin": "workspace:*",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.6.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@tanstack/react-query": "5.107.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.20.0"
}
