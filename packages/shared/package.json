{
  "name": "@vicacha-devs/medusa-shared-admin",
  "version": "0.0.1",
  "private": true,
  "description": "Shared admin components, hooks, and utilities for Vicacha Devs Medusa plugins",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./admin": {
      "types": "./src/admin/index.ts",
      "import": "./src/admin/index.ts",
      "default": "./dist/admin.mjs"
    },
    "./admin/hooks": {
      "import": "./src/admin/hooks/index.ts",
      "default": "./dist/admin/hooks/index.js"
    },
    "./admin/*": {
      "import": "./src/admin/*.ts",
      "default": "./src/admin/*.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.dts.json",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@types/lodash": "^4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "cmdk": "1.1.1",
    "copy-to-clipboard": "^4.0.2",
    "date-fns": "4.4.0",
    "i18next": "27.1.1",
    "lodash": "4.18.1",
    "react": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.0.3"
  },
  "peerDependencies": {
    "@medusajs/framework": "*",
    "@medusajs/icons": "*",
    "@medusajs/ui": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-popover": "*",
    "@radix-ui/react-radio-group": "*",
    "@radix-ui/react-slot": "*",
    "@tanstack/react-query": "*",
    "@tanstack/react-table": "*",
    "@uiw/react-json-view": "*",
    "cmdk": "*",
    "copy-to-clipboard": "*",
    "date-fns": "*",
    "i18next": "*",
    "lodash": "*",
    "react": "*",
    "react-hook-form": "*",
    "react-i18next": "*",
    "react-router-dom": "*",
    "zod": "4.6.7"
  }
}
