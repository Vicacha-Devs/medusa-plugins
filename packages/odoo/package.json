{
  "name": "@vicacha-devs/medusa-plugin-odoo",
  "version": "0.0.1",
  "description": "Bidirectional Odoo ERP (Odoo 14-19+ JSON-RPC 2.0 & JSON-2 API) integration plugin for Medusa v2 — products & variants, multi-warehouse inventory & drift reconciliation, orders & invoices/payments, customers, POS/warehouse barcode resolver, offline POS replay, webhooks, Prometheus metrics, SDK, React hooks & Admin UI.",
  "keywords": [
    "barcode",
    "erp",
    "inventory-reconciliation",
    "invoicing",
    "json2",
    "jsonrpc",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-odoo",
    "medusa-v2",
    "odoo",
    "pos"
  ],
  "license": "MIT",
  "author": "Vicacha Devs",
  "files": [
    ".medusa/server",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./hooks": {
      "import": "./.medusa/server/src/hooks/index.js",
      "default": "./.medusa/server/src/hooks/index.js"
    },
    "./sdk": {
      "import": "./.medusa/server/src/sdk/index.js",
      "default": "./.medusa/server/src/sdk/index.js"
    },
    "./types": {
      "import": "./.medusa/server/src/types/index.js",
      "default": "./.medusa/server/src/types/index.js"
    },
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./rbac": {
      "import": "./src/rbac.ts",
      "default": "./.medusa/server/src/rbac.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json --resolve-full-paths",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/__tests__/register-ts-resolver.mjs --import ../plugin-testing/register-js-extension.mjs --test src/__tests__/*.spec.ts",
    "clean": "rm -rf .medusa node_modules"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/core-flows": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@mikro-orm/migrations": "6.4.3",
    "@swc/core": "1.7.28",
    "@types/node": "20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jiti": "2.0.0",
    "prop-types": "15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "5.6.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/core-flows": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.20.0"
}
