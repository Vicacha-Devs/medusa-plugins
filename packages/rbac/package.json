{
  "name": "@vicacha-devs/medusa-plugin-rbac",
  "version": "0.0.1",
  "description": "Medusa v2 RBAC Admin UI, centralized plugin route enforcement, policy sync, and role-bound invitations on top of @medusajs/medusa/rbac.",
  "author": "Vicacha Devs",
  "license": "MIT",
  "files": [
    ".medusa/server",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./.medusa/server/src/index.js",
      "require": "./.medusa/server/src/index.js",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-rbac",
    "rbac",
    "roles",
    "permissions"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc-alias -p tsconfig.json",
    "publish:local": "medusa plugin:publish",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test:offline": "node --import ./src/__tests__/register-ts-resolver.mjs --test src/__tests__/*.spec.ts",
    "test": "pnpm test:offline",
    "clean": "rm -rf .medusa node_modules"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/core-flows": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/js-sdk": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/types": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@swc/core": "^1.7.28",
    "@tanstack/react-query": "5.107.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vicacha-devs/medusa-shared-admin": "workspace:*",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.6.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/icons": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/test-utils": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@tanstack/react-query": "5.107.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
