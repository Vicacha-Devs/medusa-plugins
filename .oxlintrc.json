{
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/no-control-regex": "off",
    "typescript/no-explicit-any": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off"
  },
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "**/dist/**",
    ".medusa/**",
    "**/.medusa/**",
    ".turbo/**",
    ".qa/**",
    "node_modules/**",
    "**/node_modules/**"
  ]
}
