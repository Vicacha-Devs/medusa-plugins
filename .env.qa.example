QA_TYPESENSE_API_KEY=REPLACE_WITH_LOCAL_TYPESENSE_KEY
QA_MINIO_USER=REPLACE_WITH_LOCAL_MINIO_USER
QA_MINIO_PASSWORD=REPLACE_WITH_LOCAL_MINIO_PASSWORD
